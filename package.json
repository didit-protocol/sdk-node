{
  "name": "@didit-protocol/sdk-node",
  "version": "0.1.0",
  "description": "The official Didit TypeScript and JavaScript library: identity verification (KYC), KYB, AML screening, liveness, transaction monitoring, Travel Rule and customer authentication from your backend.",
  "keywords": [
    "didit",
    "identity verification",
    "kyc",
    "kyb",
    "aml",
    "liveness",
    "transaction monitoring",
    "travel rule",
    "authentication"
  ],
  "homepage": "https://didit.me",
  "documentation": "https://docs.didit.me",
  "bugs": {
    "url": "https://github.com/didit-protocol/sdk-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/didit-protocol/sdk-node.git"
  },
  "license": "MIT",
  "author": "Didit <support@didit.me>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "generate": "node codegen/generate.ts",
    "generate:check": "node codegen/generate.ts --check",
    "spec-sync": "node codegen/spec-sync.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check:package": "publint --strict && attw --pack . --profile node16"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.13.0",
    "express": "5.3.0",
    "fastify": "5.12.7",
    "globals": "17.13.0",
    "hono": "4.13.13",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.4"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
